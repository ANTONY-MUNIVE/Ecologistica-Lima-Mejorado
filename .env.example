# Copiar a .env en la raiz y completar privadamente antes de usar Compose.
# .env esta ignorado por Git. No registrar valores reales en este archivo.
POSTGRES_DB=ecologistica_local
POSTGRES_USER=ecologistica_local
POSTGRES_PASSWORD=

# Usar las mismas credenciales/base de datos que arriba y el host interno db:5432.
# Codificar en porcentaje los caracteres reservados del usuario/contrasena.
# Formato: postgresql+psycopg://USUARIO:CONTRASENA_CODIFICADA@db:5432/BASE
DATABASE_URL=
